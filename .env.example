# Supabase: Settings -> API in your own Supabase project.
# Use the server-side service_role/secret key, never an anon/publishable key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# Polygon RPC (default: https://polygon-rpc.com — override with Alchemy/Infura for production)
POLYGON_RPC_URL=https://polygon-rpc.com

# Keep false for current Deposit Wallet support.
FORCE_LEGACY_EXECUTION=false
